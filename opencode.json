{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "firebase": {
        "type": "local",
        "command": ["npx", "-y", "firebase-tools@latest", "mcp"],
        "timeout": {
          "startup": 30000
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"]
      },
      "whatsapp_business_tools": {
        "type": "remote",
        "url": "https://mcp.facebook.com/whatsapp_business_tools"
      }
    }
  }
}
