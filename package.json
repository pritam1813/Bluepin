{
  "name": "bluepin",
  "description": "Bluepin App",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:tokens": "tsx scripts/test_lab_report_tokens.ts",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.85.0",
    "react-joyride": "^3.2.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "uuid": "^11.1.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.1",
